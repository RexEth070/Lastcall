# ==============================================================================
# LASTCALL Environment Variables (Names Only — Copy to .env.local and fill)
# Never commit .env.local or real secrets.
# ==============================================================================

# --- Web App (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_DEMO_PORTAL_URL=http://localhost:3001

# Seeded judge demo account (fixture credentials documented for hackathon judges)
DEMO_USER_EMAIL=demo@lastcall.app
DEMO_USER_PASSWORD=

# --- Worker & Agent Orchestrator ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_PORTAL_URL=http://localhost:3001
DEMO_PORTAL_EMAIL=alex.demo@cloudstream.test
DEMO_PORTAL_PASSWORD=
KANE_CLI_PATH=kane-cli
KANE_TIMEOUT_SECONDS=120
KANE_MAX_STEPS=25
WORKER_POLL_INTERVAL_MS=3000
WORKER_HEADLESS=false
